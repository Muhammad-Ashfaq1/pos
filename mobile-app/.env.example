# Optional override for the Laravel API origin (no trailing slash).
# Default: http://127.0.0.1:8000 (iOS / desktop) or http://10.0.2.2:8000 (Android emulator).
#
# Prefer dart-define when running:
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.10:8000
API_BASE_URL=http://127.0.0.1:8000
