APP_NAME=AutoServe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# Local (Mailpit): SMTP 1025, UI http://127.0.0.1:8025. Herd Pro mail uses 2525.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Support mailbox (real). info@ and admin@ should be aliases of this mailbox.
MAIL_SUPPORT_USERNAME=null
MAIL_SUPPORT_PASSWORD=null
MAIL_SUPPORT_ADDRESS="support@example.com"
MAIL_INFO_ADDRESS="info@example.com"
MAIL_ADMIN_ADDRESS="admin@example.com"

# Hostinger Business Email (production) example:
#
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=noreply@obtainsolutions.com
# MAIL_PASSWORD=your-noreply-password
# MAIL_FROM_ADDRESS="noreply@obtainsolutions.com"
# MAIL_FROM_NAME="${APP_NAME}"
#
# MAIL_SUPPORT_USERNAME=support@obtainsolutions.com
# MAIL_SUPPORT_PASSWORD=your-support-password
# MAIL_SUPPORT_ADDRESS="support@obtainsolutions.com"
# MAIL_INFO_ADDRESS="info@obtainsolutions.com"
# MAIL_ADMIN_ADDRESS="admin@obtainsolutions.com"
#
# If port 465 fails, try STARTTLS on 587:
# MAIL_SCHEME=null
# MAIL_PORT=587
#
# Routing:
# - noreply  → auth, signup, forgot/reset, customer portal links
# - info     → invoices/bills share, shop status (sent via support SMTP as alias)
# - admin    → optional ops/admin notices (alias of support)
# - support  → human replies (read this inbox)
#
# Smoke tests: /test-email/{noreply|info|admin|support}?to=you@example.com

SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=superadmin@obtainsolutions.com
SUPER_ADMIN_PASSWORD=password

SEED_EMAIL_DOMAIN=obtainsolutions.com
DEMO_SHOP_NAME="Rapid Lube Downtown"
DEMO_SHOP_EMAIL=admin1@obtainsolutions.com
DEMO_SHOP_PASSWORD=password
DEMO_SHOP_WEBSITE_URL=https://shops.obtainsolutions.com/shop-1
DEMO_SHOP_WEBSITE_BASE_URL=https://shops.obtainsolutions.com
DEMO_ACTIVE_SHOPS_COUNT=3
DEMO_EMPLOYEES_PER_SHOP=3
TENANT_DEMO_PASSWORD=password
SEED_TENANT_ROLE_USERS=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Progressive Web App service worker (keep false until hosting is stable)
PWA_ENABLED=false
